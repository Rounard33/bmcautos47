# Configuration KeplerVO API pour développement local
# Copier ce fichier en .env et remplir avec vos vraies valeurs

# Clé API KeplerVO (obligatoire)
KEPLER_API_KEY=votre_cle_api_ici

# URL de l'API KeplerVO (optionnel, défaut : https://app.keplervo-uat.com/api)
KEPLER_API_URL=https://app.keplervo-uat.com/api

# Pour tester localement :
# 1. Copier ce fichier : cp .env.example .env
# 2. Remplir KEPLER_API_KEY avec votre vraie clé
# 3. Lancer : vercel dev
# 4. Ouvrir : http://localhost:3000
