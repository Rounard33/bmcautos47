# Configuration KEPLER SOFT API
KEPLER_API_KEY=votre_cle_api_ici
KEPLER_API_URL=https://app.keplervo.com/api

# Configuration du site (pour build production)
# COMING_SOON: true = affiche "Arrive bientôt", false = site complet
COMING_SOON=false

# USE_MOCK_DATA: true = force les mock data, false = utilise l'API KEPLER
USE_MOCK_DATA=false
